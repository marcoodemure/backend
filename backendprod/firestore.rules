rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function userRole(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data.role;
    }

    function isAdmin() {
      return signedIn() && userRole(request.auth.uid) == "admin";
    }

    match /users/{uid} {
      // Owners can create their own profile, but cannot self-assign admin role.
      allow create: if isOwner(uid)
        && request.resource.data.uid == uid
        && request.resource.data.role == "customer";

      allow read: if isOwner(uid) || isAdmin();

      // Owners can update their own profile fields, but cannot change uid/role.
      allow update: if isAdmin() || (
        isOwner(uid)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.role == resource.data.role
      );

      allow delete: if false;

      match /orders/{orderId} {
        allow read: if isOwner(uid) || isAdmin();
        allow create: if isOwner(uid) || isAdmin();
        allow update: if isOwner(uid) || isAdmin();
        allow delete: if false;
      }
    }

    // Required for collectionGroup("orders") admin queries in panel analytics/listeners.
    match /{path=**}/orders/{orderId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    match /carts/{uid} {
      allow read, write: if isOwner(uid) || isAdmin();
    }

    match /support_chats/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create, update: if isOwner(uid)
        && request.resource.data.uid == uid
        && request.resource.data.messages is list
        && request.resource.data.messages.size() <= 120;
      allow delete: if false;
    }

    match /support_tickets/{ticketId} {
      allow create: if signedIn()
        && request.resource.data.requesterUid == request.auth.uid
        && request.resource.data.requesterEmail is string
        && request.resource.data.summary is string
        && request.resource.data.summary.size() <= 240
        && request.resource.data.details is string
        && request.resource.data.details.size() <= 2000
        && request.resource.data.status is string
        && request.resource.data.priority is string;

      allow read: if signedIn() && (
        resource.data.requesterUid == request.auth.uid
        || isAdmin()
      );

      allow update: if isAdmin() || (
        signedIn()
        && resource.data.requesterUid == request.auth.uid
        && request.resource.data.requesterUid == resource.data.requesterUid
      );

      allow delete: if false;
    }

    match /support_ticket_messages/{messageId} {
      allow create: if signedIn()
        && request.resource.data.ticketId is string
        && request.resource.data.ticketId.size() > 0
        && request.resource.data.requesterUid is string
        && request.resource.data.senderUid == request.auth.uid
        && request.resource.data.senderRole is string
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 2000
        && (
          isAdmin()
          || request.resource.data.requesterUid == request.auth.uid
        )
        && request.resource.data.requesterUid
          == get(/databases/$(database)/documents/support_tickets/$(request.resource.data.ticketId)).data.requesterUid;

      allow read: if signedIn() && (
        isAdmin()
        || get(/databases/$(database)/documents/support_tickets/$(resource.data.ticketId)).data.requesterUid == request.auth.uid
      );

      allow update, delete: if false;
    }

    match /unresolved_questions/{questionId} {
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.queryText is string
        && request.resource.data.queryText.size() > 0
        && request.resource.data.queryText.size() <= 500
        && request.resource.data.normalizedQuery is string
        && request.resource.data.normalizedQuery.size() > 0
        && request.resource.data.normalizedQuery.size() <= 500
        && request.resource.data.language is string;

      allow read: if isAdmin() || (
        signedIn()
        && resource.data.uid == request.auth.uid
      );
      allow update: if isAdmin() || (
        signedIn()
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.status == resource.data.status
        && request.resource.data.resolvedNote == resource.data.resolvedNote
        && request.resource.data.resolvedBy == resource.data.resolvedBy
      );
      allow delete: if false;
    }

    match /stock_alerts/{alertId} {
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email is string
        && request.resource.data.productName is string
        && request.resource.data.desiredSize is string
        && request.resource.data.status is string
        && (
          request.resource.data.productId is int
          || request.resource.data.productId is float
          || request.resource.data.productName.size() > 0
        );

      allow read: if signedIn() && (
        resource.data.uid == request.auth.uid
        || isAdmin()
      );

      allow update: if isAdmin() || (
        signedIn()
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == resource.data.uid
      );

      allow delete: if false;
    }

    match /support_settings/{settingsId} {
      allow read: if true;
      allow create, update: if isAdmin();
      allow delete: if false;
    }

    match /support_preferences/{uid} {
      allow read: if isOwner(uid) || isAdmin();

      allow create, update: if isAdmin() || (
        isOwner(uid)
        && request.resource.data.uid == uid
      );

      allow delete: if false;
    }

    match /products/{productId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /payment_sessions/{sessionId} {
      allow read, create, update: if true;
      allow delete: if false;
    }

    match /order_audit/{auditId} {
      allow create: if signedIn();
      allow read: if isAdmin();
      allow update, delete: if false;
    }

    match /mail/{mailId} {
      allow create: if signedIn();
      allow read, update, delete: if false;
    }

    match /return_requests/{requestId} {
      allow create: if signedIn() && request.resource.data.requesterUid == request.auth.uid;
      allow read, update: if signedIn() && (
        resource.data.requesterUid == request.auth.uid
        || isAdmin()
      );
      allow delete: if false;
    }

    match /notifications/{notificationId} {
      allow create: if signedIn() && (
        request.resource.data.uid == request.auth.uid
        || isAdmin()
      );
      allow read, update: if signedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      allow delete: if false;
    }

    match /product_comments/{commentId} {
      allow read: if true;

      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.productId is int
        && request.resource.data.productId > 0
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 800
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() <= 80
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 160;

      allow update, delete: if false;
    }

    match /donations/{donationId} {
      allow read: if true;

      allow create: if
        request.resource.data.paymentSessionId == donationId
        && (
          request.resource.data.amount is int
          || request.resource.data.amount is float
        )
        && request.resource.data.amount > 0
        && request.resource.data.amount <= 1000000
        && request.resource.data.currency is string
        && request.resource.data.currency.size() > 0
        && request.resource.data.currency.size() <= 8
        && request.resource.data.donorName is string
        && request.resource.data.donorName.size() > 0
        && request.resource.data.donorName.size() <= 80
        && request.resource.data.donorDisplayName is string
        && request.resource.data.donorDisplayName.size() > 0
        && request.resource.data.donorDisplayName.size() <= 80
        && request.resource.data.isAnonymous is bool
        && request.resource.data.message is string
        && request.resource.data.message.size() <= 500
        && request.resource.data.status == "completed"
        && request.resource.data.uid is string
        && request.resource.data.uid.size() <= 128
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 160
        && request.resource.data.source is string
        && request.resource.data.source.size() > 0
        && request.resource.data.source.size() <= 40
        && request.resource.data.paymentMethod is string
        && request.resource.data.paymentMethod.size() > 0
        && request.resource.data.paymentMethod.size() <= 40;

      allow update, delete: if false;
    }
  }
}
